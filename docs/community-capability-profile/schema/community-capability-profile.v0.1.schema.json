{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charlestonhacks.com/schemas/community-capability-profile/v0.1.json",
  "title": "Community Capability Profile",
  "description": "An open, community-agnostic description of a community's identity, collective capabilities, and how to engage with it. Draft v0.1.",
  "type": "object",
  "required": ["specVersion", "id", "generatedAt", "assertion", "identity", "accessibility"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "specVersion": { "type": "string", "pattern": "^0\\.1\\.\\d+$" },
    "id": { "$ref": "#/$defs/httpsUrl" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "refreshIntervalHours": { "type": "integer", "minimum": 1, "maximum": 720 },
    "inLanguage": { "type": "string", "default": "en" },
    "assertion": { "$ref": "#/$defs/assertion" },
    "identity": { "$ref": "#/$defs/identity" },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "intent": { "$ref": "#/$defs/intent" },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "needs": { "type": "array", "items": { "$ref": "#/$defs/need" } },
    "opportunities": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } },
    "activities": { "type": "array", "items": { "$ref": "#/$defs/activity" } },
    "themes": { "type": "array", "items": { "$ref": "#/$defs/theme" } },
    "partners": { "type": "array", "items": { "$ref": "#/$defs/partner" } },
    "accessibility": { "$ref": "#/$defs/accessibility" },
    "privacy": { "$ref": "#/$defs/privacy" }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "ref": { "type": "string", "pattern": "^(cap|project|need|theme|opp|activity|partner):[A-Za-z0-9._-]+$" },
    "band": { "type": "string", "enum": ["3-4", "5-10", "11-25", "26-50", "51+"] },
    "source": {
      "type": "object",
      "required": ["retrievedAt"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["self-published", "inferred"] },
        "url": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date-time" }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["self-published", "inferred"] },
        "publisher": { "$ref": "#/$defs/httpsUrl" },
        "compiledBy": { "type": "string" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "confidence": { "enum": ["low", "medium", "high"] },
        "participation": { "enum": ["confirmed", "not-confirmed"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "inferred" } } },
          "then": {
            "required": ["compiledBy", "sources", "confidence", "participation"],
            "properties": { "participation": { "const": "not-confirmed" }, "sources": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "self-published" } } },
          "then": { "required": ["publisher"] }
        }
      ]
    },
    "identity": {
      "type": "object",
      "required": ["name", "url", "summary"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "alternateNames": { "type": "array", "items": { "type": "string" } },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
        "mission": { "type": "string", "maxLength": 1000 },
        "values": { "type": "array", "items": { "type": "string" } },
        "focusAreas": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object", "required": ["label"], "additionalProperties": false,
                "properties": { "label": { "type": "string" }, "sameAs": { "type": "string", "format": "uri" } }
              }
            ]
          }
        },
        "audience": { "type": "array", "items": { "type": "string" } },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "locality": { "type": "string" },
            "region": { "type": "string" },
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "areaServed": { "type": "array", "items": { "type": "string" } }
          }
        },
        "founded": { "type": "string" },
        "culture": { "type": "string", "maxLength": 1000 },
        "logo": { "$ref": "#/$defs/httpsUrl" },
        "sameAs": { "type": "array", "items": { "$ref": "#/$defs/httpsUrl" } }
      }
    },
    "evidenceLevel": {
      "type": "object",
      "required": ["band"],
      "additionalProperties": false,
      "properties": {
        "band": { "$ref": "#/$defs/band" },
        "examples": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "capability": {
      "type": "object",
      "required": ["id", "label", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/ref" },
        "label": { "type": "string" },
        "category": { "type": "string" },
        "sameAs": { "type": "string", "format": "uri" },
        "evidence": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "declared": { "$ref": "#/$defs/evidenceLevel" },
            "endorsed": { "$ref": "#/$defs/evidenceLevel" },
            "demonstrated": { "$ref": "#/$defs/evidenceLevel" },
            "available": { "$ref": "#/$defs/evidenceLevel" }
          }
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "phraseOrRef": { "type": "string", "minLength": 1, "maxLength": 300 },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "has": { "type": "array", "items": { "$ref": "#/$defs/phraseOrRef" } },
        "needs": { "type": "array", "items": { "$ref": "#/$defs/phraseOrRef" } },
        "building": { "type": "array", "items": { "$ref": "#/$defs/phraseOrRef" } },
        "exploring": { "type": "array", "items": { "$ref": "#/$defs/phraseOrRef" } },
        "offers": { "type": "array", "items": { "$ref": "#/$defs/phraseOrRef" } },
        "openTo": { "type": "array", "items": { "$ref": "#/$defs/phraseOrRef" } }
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "title", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/ref" },
        "title": { "type": "string" },
        "summary": { "type": "string", "maxLength": 1000 },
        "status": { "enum": ["open", "active", "completed", "paused"] },
        "skillsNeeded": { "type": "array", "items": { "type": "string" } },
        "themes": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "evidence": { "enum": ["untested", "tested", "proven"] },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "need": {
      "type": "object",
      "required": ["id", "kind", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/ref" },
        "kind": { "enum": ["skill", "mentorship", "resource", "funding", "venue", "partner", "other"] },
        "description": { "type": "string", "maxLength": 500 },
        "relatedProject": { "$ref": "#/$defs/ref" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "opportunity": {
      "type": "object",
      "required": ["id", "title", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/ref" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "summary": { "type": "string", "maxLength": 1000 },
        "skills": { "type": "array", "items": { "type": "string" } },
        "locationType": { "type": "string" },
        "commitment": { "type": "string" },
        "deadline": { "type": "string", "format": "date-time" },
        "organization": { "$ref": "#/$defs/ref" },
        "applyUrl": { "$ref": "#/$defs/httpsUrl" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "activity": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/ref" },
        "name": { "type": "string" },
        "description": { "type": "string", "maxLength": 1000 },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "recurrence": { "type": "string" },
        "location": { "type": "string" },
        "eventAttendanceMode": { "enum": ["offline", "online", "mixed"] },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "organizer": { "type": "string" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "theme": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/ref" },
        "title": { "type": "string" },
        "description": { "type": "string", "maxLength": 1000 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "participants": { "$ref": "#/$defs/band" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "partner": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/ref" },
        "name": { "type": "string" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "description": { "type": "string", "maxLength": 1000 },
        "relationship": { "type": "string" },
        "verified": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["type", "url"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ccp-json", "jsonld", "rest", "mcp", "ard-catalog", "ical", "rss", "html"] },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "description": { "type": "string" }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["humanUrl"],
      "additionalProperties": false,
      "properties": {
        "humanUrl": { "$ref": "#/$defs/httpsUrl" },
        "join": {
          "type": "object", "additionalProperties": false,
          "properties": { "url": { "$ref": "#/$defs/httpsUrl" }, "summary": { "type": "string" } }
        },
        "contact": {
          "type": "object", "additionalProperties": false,
          "properties": { "url": { "$ref": "#/$defs/httpsUrl" } }
        },
        "endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpoint" } },
        "collaborationRequests": {
          "type": "object", "required": ["supported"], "additionalProperties": false,
          "properties": { "supported": { "type": "boolean" }, "url": { "$ref": "#/$defs/httpsUrl" } }
        },
        "agentPolicy": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "privacy": {
      "type": "object",
      "required": ["minimumGroupSize", "individualDisclosure"],
      "additionalProperties": false,
      "properties": {
        "minimumGroupSize": { "type": "integer", "minimum": 3 },
        "countsAreBanded": { "type": "boolean" },
        "individualDisclosure": { "enum": ["none", "opt-in"] },
        "policyUrl": { "$ref": "#/$defs/httpsUrl" }
      }
    }
  }
}
